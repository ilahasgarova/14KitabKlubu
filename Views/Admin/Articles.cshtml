@model List<KitabKlubu.Models.Article>
@{
    ViewData["Title"] = "Məqalələri İdarə Et";
}

<div class="hero-box p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <h1 class="h3 fw-bold mb-0">Məqalələr</h1>
    <div>
        <a href="/Admin/AddArticle" class="btn btn-book-primary me-2">+ Məqalə Əlavə Et</a>
        <a href="/Admin/Dashboard" class="btn btn-outline-light">← Dashboard-a qayıt</a>
    </div>
</div>

<div class="book-card p-4 mb-5">
    @if (Model.Count == 0)
    {
        <p class="text-secondary mb-0">Hələ məqalə yoxdur.</p>
    }
    else
    {
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>İkon</th>
                    <th>Başlıq</th>
                    <th>Tarix</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var meqale in Model)
                {
                    <tr>
                        <td>@meqale.Icon</td>
                        <td>@meqale.Title</td>
                        <td>@meqale.Date</td>
                        <td>
                            <a href="/Admin/EditArticle/@meqale.Id" class="btn btn-sm btn-outline-light me-1">Redaktə</a>
                            <a href="/Admin/DeleteArticle/@meqale.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmək istədiyinə əminsən?');">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>