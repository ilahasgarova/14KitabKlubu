@model KitabKlubu.Models.Article
@{
    ViewData["Title"] = "Məqaləni Redaktə Et";
}

<div class="hero-box p-4 mb-4">
    <a href="/Admin/Articles" class="text-secondary small text-decoration-none">← Məqalələrə qayıt</a>
    <h1 class="h3 fw-bold mt-2 mb-0">Məqaləni Redaktə Et</h1>
</div>

<div class="book-card p-4 mb-5">
    <form method="post" action="/Admin/EditArticle">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="Date" value="@Model.Date" />

        <div class="mb-3">
            <label class="form-label text-light">İkon (emoji)</label>
            <input type="text" name="Icon" class="form-control" value="@Model.Icon" required />
        </div>
        <div class="mb-3">
            <label class="form-label text-light">Başlıq</label>
            <input type="text" name="Title" class="form-control" value="@Model.Title" required />
        </div>
        <div class="mb-3">
            <label class="form-label text-light">Qısa xülasə</label>
            <textarea name="Summary" class="form-control" rows="2" required>@Model.Summary</textarea>
        </div>
        <div class="mb-3">
            <label class="form-label text-light">Tam mətn</label>
            <textarea name="Content" class="form-control" rows="6" required>@Model.Content</textarea>
        </div>
        <button type="submit" class="btn btn-book-primary px-4">Yadda Saxla</button>
    </form>
</div>