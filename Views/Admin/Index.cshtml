@model List<KitabKlubu.Models.Book>
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="hero-box p-4 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <h1 class="h3 fw-bold mb-0">Admin Panel — Kitablar</h1>
    <div>
        <a href="/Admin/Dashboard" class="text-secondary small text-decoration-none d-block mt-1">← Dashboard-a qayıt</a>
        <a href="/Admin/AddBook" class="btn btn-book-primary me-2">+ Kitab Əlavə Et</a>
        <a href="/Admin/Articles" class="btn btn-outline-light me-2">Məqalələri İdarə Et</a>
        <a href="/Account/Logout" class="btn btn-outline-danger">Çıxış</a>
    </div>
</div>

<div class="book-card p-4 mb-5">
    @if (Model.Count == 0)
    {
        <p class="text-secondary mb-0">Hələ kitab yoxdur.</p>
    }
    else
    {
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Müəllif</th>
                    <th>Qiymət</th>
                    <th>Kim əlavə edib</th>
                    <th>Qeyd</th>
                    <th>Status</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kitab in Model)
                {
                    <tr>
                        <td>@kitab.Title</td>
                        <td>@kitab.Author</td>
                        <td>@kitab.Price</td>
                        <td>@kitab.SubmittedBy</td>
                        <td>@kitab.Description</td>
                        <td>
                            @if (kitab.IsApproved)
                            {
                                <span class="badge bg-success">Təsdiqlənib</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Gözləyir</span>
                            }
                        </td>
                        <td>
                            @if (!kitab.IsApproved)
                            {
                                <a href="/Admin/Approve/@kitab.Id" class="btn btn-sm btn-success me-1">Təsdiqlə</a>
                            }
                            else
                            {
                                <a href="/Admin/Reject/@kitab.Id" class="btn btn-sm btn-warning me-1">Gizlət</a>
                            }
                            <a href="/Admin/Edit/@kitab.Id" class="btn btn-sm btn-outline-light me-1">Redaktə</a>
                            <a href="/Admin/Delete/@kitab.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silmək istədiyinə əminsən?');">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>