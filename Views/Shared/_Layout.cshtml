<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 14 Kitab Klubu</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "14 Kitab Klubu — kitab sevərləri bir araya gətirən icma. Kitab paylaşımı, ikinci əl kitab satışı və oxucu görüşləri.")" />
    <meta name="keywords" content="kitab klubu, Bakı kitab klubu, ikinci əl kitab, kitab paylaşımı, oxucu icması" />
    <meta property="og:title" content="@ViewData["Title"] - 14 Kitab Klubu" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "14 Kitab Klubu — kitab sevərləri bir araya gətirən icma.")" />
    <meta property="og:type" content="website" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- HEADER -->
    <nav class="navbar navbar-expand-lg py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-3" href="/">
                <img src="~/images/logo.jpeg" alt="14 Kitab Klubu" />
                <span class="fw-bold fs-4">14 Kitab Klubu</span>
            </a>
            
            <!-- Mobil menyu düyməsi (Hamburger) -->
            <button class="navbar-toggler border-light text-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>

            <!-- Açılıb-bağlanan menyu hissəsi -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-auto gap-3">
                   <a class="nav-link text-light" href="/">Ana Səhifə</a>
                   <a class="nav-link text-light" href="/Home/About">Haqqımızda</a>
                   <a class="nav-link text-light" href="/Books">Rəfdən Rəfə</a>
                   <a class="nav-link text-light" href="/Articles">Məqalələr</a>
                   <a class="nav-link text-light" href="/Contact">Əlaqə</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- CONTENT -->
    <main class="container my-5">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="py-4 text-center">
        <div class="container">
            <p class="mb-2 text-light opacity-75">✨ "Səhifələri vərəqlə, hekayələri paylaş."</p>
            <small class="text-secondary">&copy; 2026 - 14 Kitab Klubu. Bütün hüquqlar qorunur.</small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>