@{
    ViewData["Title"] = "Haqqımızda";
    ViewData["MetaDescription"] = "14 Kitab Klubu haqqında — missiyamız, dəyərlərimiz və kitab icmasına necə qoşula bilərsiniz.";
}

<!-- HERO HİSSƏSİ -->
<div class="hero-box p-4 mb-4 text-center">
    <h1 class="display-6 fw-bold mb-3">Haqqımızda</h1>
    <p class="col-md-8 mx-auto fs-5 text-light opacity-75 mb-0">
        14 Kitab Klubu — kitab sevərləri bir araya gətirən, oxumağı və paylaşmağı sevən insanların məkanı.
    </p>
</div>

<!-- MƏZMUN -->
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="book-card p-4 h-100">
            <h3 class="h5 fw-bold mb-3 text-danger">🎯 Missiyamız</h3>
            <p class="text-secondary small mb-0">
                Kitab oxumağı sevən hər kəsi bir araya gətirmək, fikir mübadiləsi etmək və oxu mədəniyyətini yaymaqdır.
                Hər ay yeni bir kitab seçir, birlikdə müzakirə edirik.
            </p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="book-card p-4 h-100">
            <h3 class="h5 fw-bold mb-3 text-danger">📖 Tariximiz</h3>
            <p class="text-secondary small mb-0">
                14 Kitab Klubu kiçik bir dost dairəsindən başladı və bu gün onlarla üzvü olan
                fəal bir oxucu icmasına çevrildi.
            </p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="book-card p-4 h-100">
            <h3 class="h5 fw-bold mb-3 text-danger">🤝 Dəyərlərimiz</h3>
            <p class="text-secondary small mb-0">
                Açıqlıq, paylaşma və hörmət — hər fikrin dəyərli olduğuna inanırıq. Kitab seçimində
                müxtəlifliyi dəstəkləyirik.
            </p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="book-card p-4 h-100">
            <h3 class="h5 fw-bold mb-3 text-danger">📅 Necə İştirak Etmək Olar?</h3>
            <p class="text-secondary small mb-0">
                Bizə qoşulmaq çox asandır — sadəcə aylıq görüşlərimizdən birinə gəlin
                və ya sosial media hesablarımızdan bizimlə əlaqə saxlayın.
            </p>
        </div>
    </div>
</div>